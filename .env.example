# Zaine App 环境配置模板
# 复制此文件为 .env 并填入真实值
# 命令: cp .env.example .env

# ─── 高德地图 ─────────────────────────────
# 申请地址: https://console.amap.com/dev/key/app
AMAP_API_KEY=YOUR_AMAP_API_KEY_HERE

# ─── 后端 API ──────────────────────────────
# 开发环境: https://dev-api.zaine.love
# 生产环境: https://zaine-api-skhntjskvp.cn-hangzhou.fcapp.run
BACKEND_BASE_URL=https://zaine-api-skhntjskvp.cn-hangzhou.fcapp.run

# ─── OSS 静态资源 ─────────────────────────
H5_SHARE_BASE_URL=https://zaine-share.oss-cn-hangzhou.aliyuncs.com/index.html
OSS_LANDING_PAGE_URL=https://zaine-share.oss-cn-hangzhou.aliyuncs.com/landing.html

# ─── Landing 页域名 ───────────────────────
LANDING_BASE_URL=https://zaine.love
